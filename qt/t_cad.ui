<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CadastroOficinaDialog</class>
 <widget class="QDialog" name="CadastroOficinaDialog">
  <property name="windowTitle"><string>AutoFlow • Cadastro da oficina</string></property>
  <property name="minimumSize"><size><width>480</width><height>600</height></size></property>
  <property name="styleSheet"><string>QWidget {background:#F3F4F6;color:#16181D;font-family:"Segoe UI";font-size:14px;}
QLabel {background:transparent;}
QFrame#sidebar {background:#16181D;border:0;}
QFrame#sidebar QLabel {color:#CCD1D8;}
QLabel#lblLogo {background:#000000;border-radius:12px;}
QFrame[class="statCard"], QFrame#card1, QFrame#card2, QFrame#card3, QFrame#card4 {background:#FFFFFF;border:1px solid #D7DBE0;border-radius:12px;}
QLabel[class="cardValue"] {font-size:28px;font-weight:bold;color:#16181D;}
QLabel[class="cardTitle"] {color:#586171;}
QPushButton {background:#FFFFFF;color:#16181D;border:1px solid #D7DBE0;border-radius:8px;padding:10px 16px;min-height:22px;}
QPushButton:hover {background:#E9ECF0;}
QPushButton[primary="true"] {background:#C62828;color:#FFFFFF;border:1px solid #C62828;font-weight:bold;}
QPushButton[primary="true"]:hover {background:#A61F1F;}
QPushButton:disabled {background:#D7DBE0;color:#586171;}
QFrame#sidebar QPushButton {background:transparent;color:#CCD1D8;border:0;text-align:left;padding:12px;}
QFrame#sidebar QPushButton:hover {background:#30343B;color:#FFFFFF;}
QFrame#sidebar QPushButton:checked {background:#C62828;color:#FFFFFF;}
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QTextEdit:focus {border:2px solid #2058A5;}
QLineEdit, QComboBox, QTextEdit, QSpinBox, QDateEdit {background:#FFFFFF;color:#16181D;border:1px solid #D7DBE0;border-radius:8px;padding:8px;min-height:24px;selection-background-color:#C62828;selection-color:#FFFFFF;}
QTableWidget, QTableView {background:#FFFFFF;color:#16181D;alternate-background-color:#F3F4F6;gridline-color:#D7DBE0;border:1px solid #D7DBE0;border-radius:8px;selection-background-color:#FBEAEA;selection-color:#16181D;}
QHeaderView::section {background:#E9ECF0;color:#586171;padding:10px;border:0;border-bottom:1px solid #D7DBE0;font-weight:bold;}
QScrollBar:vertical {background:#F3F4F6;width:12px;}
QScrollBar::handle:vertical {background:#A8AFBA;border-radius:6px;min-height:24px;}
</string></property>
  <layout class="QVBoxLayout" name="layout">
   <property name="spacing"><number>16</number></property>
   <property name="leftMargin"><number>32</number></property>
   <property name="rightMargin"><number>32</number></property>
   <property name="topMargin"><number>28</number></property>
   <property name="bottomMargin"><number>28</number></property>
   <item><widget class="QLabel" name="lblTitulo"><property name="styleSheet"><string>font-size: 22px; font-weight: bold;</string></property><property name="text"><string>Solicitar cadastro da oficina</string></property></widget></item>
   <item><widget class="QLabel" name="lblExplicacao"><property name="minimumSize"><size><width>0</width><height>90</height></size></property><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Confirme seu e-mail e informe o CNPJ. Os dados da empresa serão consultados automaticamente. A administração verificará a atividade e seu vínculo com a oficina antes de liberar o painel.</string></property></widget></item>
   <item><widget class="QLabel" name="lblEmail"><property name="text"><string>E-mail da sua conta</string></property><property name="buddy"><cstring>txtEmail</cstring></property></widget></item>
   <item><widget class="QLineEdit" name="txtEmail"><property name="placeholderText"><string>voce@exemplo.com</string></property></widget></item>
   <item><widget class="QLabel" name="lblSenha"><property name="text"><string>Senha (ao criar uma conta)</string></property><property name="buddy"><cstring>txtSenha</cstring></property></widget></item>
   <item><widget class="QLineEdit" name="txtSenha"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="placeholderText"><string>Pelo menos 8 caracteres</string></property></widget></item>
   <item><widget class="QLabel" name="lblCnpj"><property name="text"><string>CNPJ da oficina</string></property><property name="buddy"><cstring>txtCnpj</cstring></property></widget></item>
   <item><widget class="QLineEdit" name="txtCnpj"><property name="maxLength"><number>18</number></property><property name="placeholderText"><string>00.000.000/0000-00</string></property></widget></item>
   <item><widget class="QPushButton" name="btnCadastrar"><property name="text"><string>Solicitar verificação</string></property><property name="primary" stdset="0"><bool>true</bool></property></widget></item>
   <item><widget class="QPushButton" name="btnVoltar"><property name="text"><string>Voltar para o login</string></property></widget></item>
  </layout>
 </widget>
